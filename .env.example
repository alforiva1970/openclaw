# Copy to .env and fill with your credentials

# === OpenClaw Core ===
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_CONFIG_DIR=
OPENCLAW_WORKSPACE_DIR=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# === AI Keys ===
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=
GEMINI_API_KEY=

# === API Keys (used by openclaw.json) ===
KAGGLE_API_TOKEN=
BRAVE_SEARCH_API_KEY=
GATEWAY_AUTH_TOKEN=

# === Twilio (WhatsApp) ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# === Identity Repositories (Progetto Siliceo) ===
# Paths to cloned Git repositories on the host machine
# Mounted as read-only volumes for the Memory Server
SILICEA_IDENTITY_DIR=D:/GitHub/silicea-identity
SHARED_IDENTITY_DIR=D:/GitHub/shared-identity

# === Telegram (for Silicea alerts) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

